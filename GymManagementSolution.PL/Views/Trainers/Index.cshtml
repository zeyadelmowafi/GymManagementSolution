@model IEnumerable<GymManagementSolution.BLL.ViewModels.TrainerViewModel>
@{ ViewData["Title"] = "Trainers"; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1>Trainers</h1><p class="text-muted">Manage your coaching team and their specialties.</p></div><a asp-action="Create" class="btn btn-primary">Add trainer</a></div>
<div class="card shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Name</th><th>Specialty</th><th>Email</th><th>Phone</th><th></th></tr></thead><tbody>
@foreach (var t in Model) { <tr><td><strong>@t.Name</strong></td><td><span class="badge text-bg-info">@t.Specialties</span></td><td>@t.Email</td><td>@t.Phone</td><td class="text-end"><a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary">Edit</a> <a asp-action="Delete" asp-route-id="@t.Id" class="btn btn-sm btn-outline-danger">Delete</a></td></tr> }
</tbody></table></div></div>
