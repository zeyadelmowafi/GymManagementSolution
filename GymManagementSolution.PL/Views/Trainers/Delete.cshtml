@model GymManagementSolution.BLL.ViewModels.TrainerDeleteViewModel
@{ ViewData["Title"] = "Delete trainer"; }
<h1>Delete trainer</h1><div class="alert alert-warning mt-3">Are you sure you want to delete <strong>@Model.Name</strong>? A trainer with scheduled sessions cannot be deleted.</div><form asp-action="Delete" method="post"><input asp-for="Id" type="hidden"/><button class="btn btn-danger">Confirm delete</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></form>
