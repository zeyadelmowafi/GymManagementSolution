@model GymManagementSolution.BLL.ViewModels.PlanViewModel
@{ ViewData["Title"] = "Plan details"; }
<h1>@Model.Name</h1><div class="card shadow-sm mt-3"><div class="card-body"><p>@Model.Description</p><p><strong>Duration:</strong> @Model.DurationDays days</p><p><strong>Price:</strong> @Model.Price.ToString("C")</p><p><strong>Status:</strong> @(Model.IsActive ? "Active" : "Inactive")</p><a asp-action="Index" class="btn btn-outline-secondary">Back</a></div></div>
