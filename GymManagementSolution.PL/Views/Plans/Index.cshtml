@model IEnumerable<GymManagementSolution.BLL.ViewModels.PlanViewModel>
@{ ViewData["Title"] = "Membership plans"; }
<div class="mb-4"><h1>Membership plans</h1><p class="text-muted">Pricing and duration for available plans.</p></div><div class="row g-4">
@foreach(var p in Model){<div class="col-md-6 col-xl-3"><div class="card h-100 shadow-sm"><div class="card-body"><div class="d-flex justify-content-between"><h3 class="h5">@p.Name</h3><span class="badge @(p.IsActive ? "text-bg-success" : "text-bg-secondary")">@(p.IsActive ? "Active" : "Inactive")</span></div><p class="text-muted">@p.Description</p><div class="display-6">@p.Price.ToString("C")</div><p>@p.DurationDays days</p><a asp-action="Details" asp-route-id="@p.Id" class="btn btn-outline-primary btn-sm">Details</a> <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-outline-secondary btn-sm">Edit</a><form asp-action="Activate" asp-route-id="@p.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-dark">@(p.IsActive ? "Deactivate" : "Activate")</button></form></div></div></div>}
</div>
