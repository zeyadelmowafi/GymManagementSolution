@model GymManagementSolution.BLL.ViewModels.DashboardViewModel
@{ ViewData["Title"] = "Dashboard"; }
<section class="rounded-4 p-4 p-lg-5 mb-4 text-white" style="background:linear-gradient(120deg,#101827,#234a70)"><div class="row align-items-center"><div class="col-lg-8"><span class="text-uppercase small fw-semibold opacity-75">Power Fitness · Management</span><h1 class="display-5 fw-bold mt-2">Train smarter.<br/>Manage everything.</h1><p class="lead opacity-75">A quick view of your gym, team and scheduled sessions.</p><a asp-controller="Sessions" asp-action="Index" class="btn btn-light fw-semibold">Explore sessions</a></div><div class="col-lg-4 text-lg-end mt-4 mt-lg-0"><span class="display-1">🏋️</span></div></div></section>
<div class="d-flex justify-content-between align-items-end mb-3"><div><h2 class="h4 mb-1">Gym overview</h2><p class="text-muted mb-0">Live counts from your gym records.</p></div></div>
<div class="row g-3">
@{ var cards = new[] { ("Total Members", Model.TotalMembers, "👥", "primary"), ("Active Members", Model.ActiveMembers, "✅", "success"), ("Trainers", Model.TotalTrainers, "🏅", "info"), ("Upcoming Sessions", Model.UpcomingSessions, "📅", "primary"), ("Ongoing Sessions", Model.OngoingSessions, "🔥", "warning"), ("Completed Sessions", Model.CompletedSessions, "🏁", "secondary") }; }
@foreach(var card in cards){<div class="col-sm-6 col-xl-4"><div class="card border-0 shadow-sm h-100"><div class="card-body d-flex justify-content-between align-items-center"><div><div class="text-muted">@card.Item1</div><div class="display-6 fw-semibold">@card.Item2</div></div><span class="badge rounded-circle text-bg-@card.Item4 p-3 fs-4">@card.Item3</span></div></div></div>}
</div>
<div class="row g-3 mt-2"><div class="col-md-4"><a asp-controller="Members" asp-action="Index" class="btn btn-outline-dark w-100 p-3">Manage members →</a></div><div class="col-md-4"><a asp-controller="Trainers" asp-action="Index" class="btn btn-outline-dark w-100 p-3">Manage trainers →</a></div><div class="col-md-4"><a asp-controller="Plans" asp-action="Index" class="btn btn-outline-dark w-100 p-3">View plans →</a></div></div>
