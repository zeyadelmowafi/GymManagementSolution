@model CreateSessionViewModel
@{ ViewData["Title"] = "Create session"; }
<div class="page-heading"><div><span class="eyebrow">TRAINING SCHEDULE</span><h1>Create a session</h1><p>Set the class details, coach, and time.</p></div></div><form asp-action="Create" method="post" class="form-card"><partial name="_Form" model="Model"/><div class="mt-4"><button class="btn btn-primary">Create session</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> <script>document.getElementById('categorySelect')?.addEventListener('change', async e => { const response = await fetch('@Url.Action("TrainersForCategory", "Sessions")?categoryId=' + e.target.value); if (!response.ok) return; const items = await response.json(); const select = document.getElementById('trainerSelect'); select.innerHTML = '<option value="0">Choose trainer</option>'; items.forEach(x => select.add(new Option(x.text, x.value))); });</script> }
