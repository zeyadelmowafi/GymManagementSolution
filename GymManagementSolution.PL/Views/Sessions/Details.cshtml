@model SessionViewModel
@{ ViewData["Title"] = "Session details"; var color = Model.Status == "Upcoming" ? "primary" : Model.Status == "Ongoing" ? "success" : "secondary"; }
<div class="page-heading"><div><span class="eyebrow">SESSION DETAILS</span><h1>@Model.CategoryName</h1></div><a asp-action="Index" class="btn btn-outline-secondary">Back to list</a></div>
<section class="session-card shadow-sm"><div class="session-card-header bg-@color"><h2 class="h4 mb-0">@Model.CategoryName</h2><span class="badge rounded-pill text-bg-light">@Model.Status</span></div><div class="p-4"><p class="lead">@Model.Description</p><div class="row g-3"><div class="col-md-6"><div class="detail-tile"><span>Trainer</span><strong>@Model.TrainerName</strong></div></div><div class="col-md-6"><div class="detail-tile"><span>Capacity</span><strong>@Model.BookedCount / @Model.Capacity spots</strong></div></div><div class="col-md-6"><div class="detail-tile"><span>Start</span><strong>@Model.StartDate.ToString("f")</strong></div></div><div class="col-md-6"><div class="detail-tile"><span>End</span><strong>@Model.EndDate.ToString("f")</strong></div></div><div class="col-md-6"><div class="detail-tile"><span>Duration</span><strong>@Model.DurationDisplay</strong></div></div></div></div></section>
